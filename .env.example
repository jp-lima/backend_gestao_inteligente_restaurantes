# Copie para .env (gitignored, nunca commitar) e preencha com o Supabase.
# Supabase > Project Settings > Database > Connection string (URI).
# Use o TRANSACTION POOLER (porta 6543) no backend Spring; reserve a DIRECT (5432) para migrations.

# Pooler (recomendado p/ Spring):
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Direta (só p/ DDL manual):
# DB_URL=jdbc:postgresql://db.xxxxx.supabase.co:5432/postgres?sslmode=require

DB_USER=postgres.xxxxx
DB_PASSWORD=troque-pela-senha-do-supabase

# JWT — gere uma chave aleatoria com 32+ bytes (ex: openssl rand -base64 32).
# Nunca commitar a chave real. Aqui vai só placeholder ficticio.
JWT_SECRET=troque-por-uma-chave-de-32-bytes-ou-mais-0123456789
JWT_ACCESS_EXP_MIN=15
JWT_REFRESH_EXP_DAYS=7
